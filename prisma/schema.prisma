generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  user
  admin
  moderator
}

enum Difficulty {
  easy
  medium
  hard
}

enum visibility {
  private
  public
}

enum ContestStatus {
  UPCOMING
  ONGOING
  ENDED
  CANCELLED
}

model User {
  id                 String    @id @default(uuid(7))
  username           String    @unique
  email              String    @unique
  fullName           String?
  password           String
  avatar             String?
  role               Role      @default(user)
  type               String    @default("Developer")
  bio                String?
  git                String?
  phone              String?   @unique
  emailVerified      Boolean   @default(false)
  status             String    @default("active")
  refreshToken       String?
  refreshTokenExpiry DateTime?
  isSubscribed       Boolean   @default(false)
  package            String    @default("free")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  //Relations 
  communitiesAdmin     Communitie[]      @relation("Admin")
  communityMemberships CommunityMember[]
  discussion           Discussion[]      @relation("discussion")
  like                 Like[]
  contestOwner         Contest[]         @relation("contestOwner")
  // contestPerticipant Contest[] @relation("contestPerticipant")
  joinedContests       Contest[]         @relation("ContestParticipants")

  submittedCodes SubmittedCode[]

  following Follower[] @relation("UserFollowers")
  followers Follower[] @relation("UserFollowing")

  comment        Comment[]
  nestedComments NestedComment[]

  @@index([username])
  @@map("users")
}

model Communitie {
  id          String            @id @default(uuid(7))
  name        String
  description String?
  avatar      String?

  adminId     String
  admin       User              @relation("Admin", fields: [adminId], references: [id])

  members     CommunityMember[]

  // Permissions
  allowMessages        Boolean @default(true)
  allowMedia           Boolean @default(true)
  allowFiles           Boolean @default(true)
  allowMemberInvite    Boolean @default(false)
  allowMemberEdit      Boolean @default(false)
  onlyAdminCanAnnounce Boolean @default(false)
  onlyAdminCanPin      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Discussion {
  id        String          @id @default(uuid(7))
  ownerId   String
  // contestId String?
  // problemId String?
  owner     User            @relation("discussion", fields: [ownerId], references: [id])
  // contest   Contest?         @relation("contest", fields: [contestId], references: [id])
  // problem   Problem?         @relation("problem", fields: [problemId], references: [id])
  content   String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  replies   NestedComment[]
  like      Like[]
  isEdited Boolean @default(false)

  @@index([ownerId])
@@index([createdAt])
}

model Like {
  id              String   @id @default(uuid(7))

  userId          String
  contestId       String?
  commentId       String?
  discussionId    String?
  nestedCommentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User            @relation(fields: [userId], references: [id])
  contest         Contest?        @relation(fields: [contestId], references: [id])
  comment         Comment?        @relation(fields: [commentId], references: [id])
  discussion      Discussion?     @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  nestedComment   NestedComment?  @relation(fields: [nestedCommentId], references: [id], onDelete: Cascade)

  @@unique([userId, contestId])
  @@unique([userId, commentId])
  @@unique([userId, discussionId])
  @@unique([userId, nestedCommentId])

  @@index([userId])
  @@index([contestId])
  @@index([commentId])
  @@index([discussionId])
  @@index([nestedCommentId])
}

// model Language {
//   id        String      @id @default(uuid(7))
//   lang      String      @unique // e.g. "python", "node", "go"
//   image     String // Docker image reference, e.g. "python:3.11-slim"
//   problems  Problem[]
//   buggyCode BuggyCode[]

//   createdAt DateTime @default(now())
// }
model Language {
  id        String @id
  lang      String @unique
  image     String

  problems  Problem[]
  buggyCode BuggyCode[]

  createdAt DateTime @default(now())
}

model Contest {
  id           String     @id @default(uuid(7))
  ownerId      String //relation with users
  // participantId String[]  //relation with users
  isCancelled  Boolean    @default(false)
  languages    String[]
  title        String
  description  String?
  contentType  String     @default("DSA")
  visibility   visibility @default(public)
  startingFrom DateTime
  endingAt     DateTime //From starting and ending time teh duration must be calculatedx
  totalPoints  Int?
  password     String?
  isProtected  Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  owner          User            @relation("contestOwner", fields: [ownerId], references: [id])
  // participant User[] @relation("contestperticipant",fields: [participantId],references: [id])
  participants   User[]          @relation("ContestParticipants")
  problems       Problem[]
  submittedCodes SubmittedCode[]
  comment        Comment[]
  likes       Like[]

  @@index([title])
}

model Problem {
  id         String     @id @default(uuid(7))
  contestId  String //relation
  title      String
  statement  String
  difficulty Difficulty @default(easy)
  //type are missing may be in future 
  tags       String[]
  constraints String[]

  contest  Contest    @relation(fields: [contestId], references: [id])
  // language Language[] @relation(fields: [languageId],references: [id])
  language Language[]

  testCases     TestCase[] //relation   i
  preloadedcode BuggyCode[] //it is optional field Also relation with buggy code

  submittedCodes SubmittedCode[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BuggyCode {
  id         String @id @default(uuid(7))
  problemId  String
  languageId String
  code       String

  problem  Problem  @relation(fields: [problemId], references: [id])
  language Language @relation(fields: [languageId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([problemId, languageId])
  @@index([problemId])
  @@index([languageId])
}

model TestCase {
  id        String @id @default(uuid(7))
  problemId String
  input     String
  output    String

  // Relation to Problem model
  problem Problem @relation(fields: [problemId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Index for faster lookups by problem
  @@index([problemId])
}

model SubmittedCode {
  id             String   @id @default(uuid(7))
  language       String // programming language used
  code           String // submitted solution code
  submissionerId String //relation with user
  problemId      String
  contestId      String?
  createdAt      DateTime @default(now())

  // Relations
  submissioner User     @relation(fields: [submissionerId], references: [id])
  problem      Problem  @relation(fields: [problemId], references: [id])
  contest      Contest? @relation(fields: [contestId], references: [id])

  // Indexes for faster lookups
}

model Follower {
  id          String   @id @default(uuid(7))
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations (self-relation to Users)
  follower  User @relation("UserFollowers", fields: [followerId], references: [id])
  following User @relation("UserFollowing", fields: [followingId], references: [id])

  @@unique([followerId, followingId]) // prevent duplicate follow records
  // Indexes for efficient lookups
  @@index([followerId])
  @@index([followingId])
}

// There will be separate class for the perticipant as we also have to rank them 

model Comment {
  id        String   @id @default(uuid(7))
  contestId String
  ownerId   String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  contest Contest         @relation(fields: [contestId], references: [id])
  owner   User            @relation(fields: [ownerId], references: [id])
  replies NestedComment[]
  likes   Like[]

  // Indexes for efficient lookups
  @@index([contestId])
  @@index([ownerId])
}

model NestedComment {
  id                 String   @id @default(uuid(7))
  content            String
  ownerId            String
  // contestId       String
  parentCommentId    String?
  parentDiscussionId String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Self relation for nested replies
  parentReplyId String?

  // Relations
  owner            User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  // contest         Contest     @relation(fields: [contestId], references: [id])
  parentComment    Comment?    @relation(fields: [parentCommentId], references: [id])
  parentDiscussion Discussion? @relation(fields: [parentDiscussionId], references: [id])

  // Self relation

  parentReply NestedComment?  @relation("ReplyTree", fields: [parentReplyId], references: [id])
  children    NestedComment[] @relation("ReplyTree")
   likes  Like[]

  // Indexes for efficient lookups
  @@index([ownerId])
  // @@index([contestId])
  @@index([parentCommentId])
  @@index([parentDiscussionId])
}

model CommunityMember {
  id          String @id @default(uuid(7))
  userId      String
  communityId String

  user      User       @relation(fields: [userId], references: [id])
  community Communitie @relation(fields: [communityId], references: [id])

  joinedAt DateTime @default(now())

  @@unique([userId, communityId])
}
